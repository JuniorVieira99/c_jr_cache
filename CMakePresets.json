{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings: vcpkg toolchain, out-of-source build folder, compile_commands.json.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-clang-cl",
      "hidden": true,
      "inherits": "base",
      "description": "Ninja + clang-cl (MSVC ABI, so vcpkg's x64-windows libraries link cleanly).",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja + clang-cl)",
      "inherits": "ninja-clang-cl",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja + clang-cl)",
      "inherits": "ninja-clang-cl",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release, Ninja + clang-cl)",
      "inherits": "release",
      "cacheVariables": { "DE_BUILD_TESTS": "OFF", "DE_BUILD_BENCHMARKS": "ON" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 solution (MSVC)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench", "configurePreset": "bench", "targets": ["JrCacheBench"] },
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "vs2026-debug", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "inherits": "test-base", "configurePreset": "vs2026", "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Configure, build and test (Debug)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    }
  ]
}
